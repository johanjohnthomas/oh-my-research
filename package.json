{
  "name": "oh-my-research",
  "version": "1.0.0",
  "description": "Local-first research workflow system for evidence-backed LaTeX paper iteration",
  "main": "./dist/research-runtime.js",
  "types": "dist/research-runtime.d.ts",
  "type": "module",
  "bin": {
    "oh-my-research": "dist/cli/index.js"
  },
  "files": [
    "dist/research-runtime.js",
    "dist/research-runtime.d.ts",
    "dist/cli/index.js",
    "dist/shared/config-errors.d.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/research-runtime.d.ts",
      "import": "./dist/research-runtime.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --outdir dist --target bun --format esm --external @ast-grep/napi && bun build src/research-runtime.ts --outdir dist --target bun --format esm --external @ast-grep/napi && tsc --emitDeclarationOnly && bun build src/cli/index.ts --outdir dist/cli --target bun --format esm --external @ast-grep/napi && bun run build:schema",
    "build:schema": "bun run script/build-schema.ts",
    "build:model-capabilities": "bun run script/build-model-capabilities.ts",
    "clean": "rm -rf dist",
    "postinstall": "node -e \"const {spawnSync}=require('node:child_process');const r=spawnSync('bun',['--version'],{stdio:'ignore'});if(r.error||r.status!==0){console.error('oh-my-research requires Bun on PATH to run the installed CLI. Install Bun from https://bun.sh first.');process.exit(1)}\"",
    "prepare": "bun run build",
    "verify:product": "bun run script/verify-product.ts",
    "test:tmux": "bun test src/shared/tmux/tmux-utils.test.ts src/shared/tmux/tmux-utils/layout.test.ts",
    "test:core": "bun test $(git ls-files '*.test.ts' '*.spec.ts' ':!:src/shared/tmux/tmux-utils.test.ts' ':!:src/shared/tmux/tmux-utils/layout.test.ts')",
    "test:model-capabilities": "bun test src/shared/model-capability-aliases.test.ts src/shared/model-capability-guardrails.test.ts src/shared/model-capabilities.test.ts src/cli/doctor/checks/model-resolution.test.ts --bail",
    "typecheck": "tsc --noEmit",
    "test": "bun run test:core && bun run test:tmux"
  },
  "keywords": [
    "research",
    "latex",
    "zotero",
    "bibliography",
    "knowledge-graph",
    "agents"
  ],
  "author": "Oh My Research contributors",
  "license": "SUL-1.0",
  "engines": {
    "bun": ">=1.3.11"
  },
  "dependencies": {
    "@ast-grep/cli": "^0.41.1",
    "@ast-grep/napi": "^0.41.1",
    "@clack/prompts": "^0.11.0",
    "@code-yeongyu/comment-checker": "^0.7.0",
    "@modelcontextprotocol/sdk": "^1.25.2",
    "@opencode-ai/plugin": "^1.4.0",
    "@opencode-ai/sdk": "^1.4.0",
    "commander": "^14.0.2",
    "detect-libc": "^2.0.0",
    "diff": "^8.0.3",
    "js-yaml": "^4.1.1",
    "jsonc-parser": "^3.3.1",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.2",
    "vscode-jsonrpc": "^8.2.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/picomatch": "^3.0.2",
    "bun-types": "1.3.11",
    "typescript": "^5.7.3"
  },
  "overrides": {},
  "trustedDependencies": [
    "@ast-grep/cli",
    "@ast-grep/napi",
    "@code-yeongyu/comment-checker"
  ]
}
